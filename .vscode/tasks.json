{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start local application",
      "type": "process",
      "command": "npm",
      "args": ["run", "start:local"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Stop local application",
      "type": "process",
      "command": "npm",
      "args": ["run", "stop:local"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Local application status",
      "type": "process",
      "command": "npm",
      "args": ["run", "status:local"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
